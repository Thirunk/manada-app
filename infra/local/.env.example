# Copy to infra/local/.env and replace every value with a strong, unique secret.
# .env is ignored by git. Never commit real values.

POSTGRES_SUPERUSER_PASSWORD=replace-me
MANADA_OWNER_PASSWORD=replace-me
MANADA_APP_PASSWORD=replace-me
KEYCLOAK_DB_PASSWORD=replace-me

KEYCLOAK_ADMIN_USERNAME=replace-me
KEYCLOAK_ADMIN_PASSWORD=replace-me

# Client secrets for the Keycloak clients (set in Keycloak by the setup script).
BFF_CLIENT_SECRET=replace-me
BACKEND_CLIENT_SECRET=replace-me
