{
  "realm": "manada",
  "displayName": "Manada",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "passwordPolicy": "length(12) and notUsername",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "defaultRoles": ["customer"],
  "roles": {
    "realm": [
      { "name": "superadmin", "description": "Manada SuperAdmin" },
      { "name": "admin", "description": "Manada Admin" },
      { "name": "staff", "description": "Manada Staff" },
      { "name": "customer", "description": "Manada Customer" }
    ]
  },
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@manada.local",
    "fromDisplayName": "Manada (local development)",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "clients": [
    {
      "clientId": "manada-bff",
      "name": "Manada Backend-for-Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://localhost:5173/signin-oidc"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/"
      },
      "defaultClientScopes": ["basic", "profile", "email", "roles"],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "manada-backend",
      "name": "Manada backend (identity administration)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false
    }
  ]
}
